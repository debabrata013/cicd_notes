<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Starlight Notes - A sleek frontend notes website with EJS, Node.js and persistent browser LocalStorage support.">
  <title><%= appTitle %> | Modern Note Taking</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <!-- Styles -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div id="app" class="app-layout">
    <%- include('partials/header') %>

    <main class="main-content">
      <div class="content-container">
        <!-- Control Bar / Toolbar -->
        <section class="toolbar-section">
          <div class="category-tabs" role="tablist" id="categoryTabs">
            <button class="tab-btn active" data-category="all" role="tab">
              <span>All Notes</span>
              <span class="count-pill" id="countAll">0</span>
            </button>
            <button class="tab-btn" data-category="personal" role="tab">
              <span>Personal</span>
              <span class="count-pill" id="countPersonal">0</span>
            </button>
            <button class="tab-btn" data-category="work" role="tab">
              <span>Work</span>
              <span class="count-pill" id="countWork">0</span>
            </button>
            <button class="tab-btn" data-category="ideas" role="tab">
              <span>Ideas</span>
              <span class="count-pill" id="countIdeas">0</span>
            </button>
            <button class="tab-btn" data-category="code" role="tab">
              <span>Code</span>
              <span class="count-pill" id="countCode">0</span>
            </button>
          </div>

          <div class="toolbar-actions">
            <div class="sort-wrapper">
              <label for="sortSelect" class="sr-only">Sort by</label>
              <select id="sortSelect" class="select-input">
                <option value="newest">Sort: Newest First</option>
                <option value="oldest">Sort: Oldest First</option>
                <option value="title">Sort: Title A-Z</option>
              </select>
            </div>

            <button id="openNewNoteBtn" class="btn btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>Create Note</span>
            </button>

            <div class="dropdown">
              <button id="moreActionsBtn" class="btn btn-secondary btn-icon" title="More Options">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
              </button>
              <div id="moreActionsMenu" class="dropdown-menu hidden">
                <button id="exportNotesBtn" class="dropdown-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  <span>Export JSON</span>
                </button>
                <label id="importNotesLabel" class="dropdown-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  <span>Import JSON</span>
                  <input type="file" id="importFileInput" accept=".json" style="display:none;">
                </label>
                <div class="dropdown-divider"></div>
                <button id="clearAllBtn" class="dropdown-item text-danger">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  <span>Clear All Notes</span>
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- Inline Note Editor Card / Modal Form -->
        <section id="noteFormContainer" class="note-form-card hidden">
          <div class="form-header">
            <h3 id="formTitle">Create New Note</h3>
            <button id="closeFormBtn" class="btn btn-icon btn-sm" title="Close editor">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
          <form id="noteForm">
            <input type="hidden" id="noteId" value="">
            
            <div class="form-group">
              <input type="text" id="noteTitleInput" class="form-input title-input" placeholder="Title your note..." required autocomplete="off">
            </div>

            <div class="form-group">
              <textarea id="noteContentInput" class="form-textarea" placeholder="Write your note content here..." rows="6" required></textarea>
              <div class="text-counter">
                <span id="charCount">0 chars</span> • <span id="wordCount">0 words</span>
                <span id="draftIndicator" class="draft-badge hidden">Draft saved locally</span>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group select-group">
                <label for="noteCategorySelect">Category</label>
                <select id="noteCategorySelect" class="form-select">
                  <option value="personal">Personal</option>
                  <option value="work">Work</option>
                  <option value="ideas">Ideas</option>
                  <option value="code">Code</option>
                </select>
              </div>

              <div class="form-group color-picker-group">
                <label>Theme Accent</label>
                <div class="color-options" id="colorOptions">
                  <button type="button" class="color-btn active" data-color="purple" style="--btn-color: #8b5cf6;" title="Purple"></button>
                  <button type="button" class="color-btn" data-color="blue" style="--btn-color: #3b82f6;" title="Blue"></button>
                  <button type="button" class="color-btn" data-color="emerald" style="--btn-color: #10b981;" title="Emerald"></button>
                  <button type="button" class="color-btn" data-color="amber" style="--btn-color: #f59e0b;" title="Amber"></button>
                  <button type="button" class="color-btn" data-color="rose" style="--btn-color: #f43f5e;" title="Rose"></button>
                  <button type="button" class="color-btn" data-color="slate" style="--btn-color: #64748b;" title="Slate"></button>
                </div>
              </div>

              <div class="form-group pin-toggle-group">
                <label class="checkbox-label">
                  <input type="checkbox" id="notePinnedInput">
                  <span>Pin to top</span>
                </label>
              </div>
            </div>

            <div class="form-actions">
              <button type="button" id="cancelNoteBtn" class="btn btn-secondary">Cancel</button>
              <button type="submit" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span id="saveBtnText">Save Note</span>
              </button>
            </div>
          </form>
        </section>

        <!-- Pinned Notes Section -->
        <section id="pinnedSection" class="notes-section hidden">
          <div class="section-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <h2>Pinned Notes</h2>
          </div>
          <div id="pinnedGrid" class="notes-grid"></div>
        </section>

        <!-- Other / All Notes Section -->
        <section id="allNotesSection" class="notes-section">
          <div class="section-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 19 8"/></svg>
            <h2 id="gridSectionHeading">All Notes</h2>
          </div>
          <div id="notesGrid" class="notes-grid"></div>
        </section>

        <!-- Empty State View -->
        <div id="emptyState" class="empty-state hidden">
          <div class="empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 19 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          </div>
          <h3>No notes found</h3>
          <p id="emptyStateMsg">Start by creating your first note! Your notes are stored locally in your browser.</p>
          <button id="emptyCreateBtn" class="btn btn-primary mt-3">Create First Note</button>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %>
  </div>

  <!-- Toast Notification -->
  <div id="toast" class="toast hidden">
    <div class="toast-content">
      <span id="toastMessage">Action completed successfully</span>
    </div>
  </div>

  <!-- Client JavaScript -->
  <script src="/js/app.js"></script>
</body>
</html>
